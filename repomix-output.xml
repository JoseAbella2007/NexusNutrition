  const { estaAutenticado, esAdministrador } = useAutenticacion();

  if (!estaAutenticado) {
    return <Navigate to={RUTAS.INICIAR_SESION} replace />;
  }

  if (!esAdministrador) {
    return <Navigate to={RUTAS.INICIO} replace />;
  }

  return <Outlet />;
}
</file>

