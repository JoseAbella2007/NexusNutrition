@import url("https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Manrope:wght@400;500;600&display=swap");

:root {
  /* Fondos oscuros */
  --bg-0: #050505;
  --bg-1: #080808;
  --bg-2: #0d0d0d;

  /* Verdes de marca (principales) */
  --green-lime: #b7ff00;
  --green-mid: #7cff3a;
  --green-classic: #39ff14;

  /* Violetas de marca (acentos) */
  --purple-1: #7b2cff;
  --purple-2: #a855f7;

  /* Blancos y grises */
  --white: #ffffff;
  --white-soft: #e5e5e5;
  --grey-mute: #8a8a8a;
  --border-soft: rgba(255, 255, 255, 0.08);

